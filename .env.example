# ============================================
# GAK CRM — Environment
# Salin jadi .env lalu isi nilainya
# ============================================

APP_NAME="GAK CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ============================================
# DATABASE — Supabase PostgreSQL
# Ambil dari: Supabase > Settings > Database
# > Connection string > Session pooler
# ============================================
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# Wajib untuk koneksi Supabase dari luar
PGSSLMODE=require

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# MAIL
# ============================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gak-crm.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SUPABASE STORAGE (foto kunjungan sales)
# Isi kalau fitur upload foto dipakai
# ============================================
SUPABASE_KEY=
SUPABASE_SECRET=
SUPABASE_BUCKET=visit-photos
SUPABASE_URL=
SUPABASE_STORAGE_URL=

VITE_APP_NAME="${APP_NAME}"
